# انسخ الملف ده لـ .env أو حط القيم دي في إعدادات الاستضافة
BASE_URL=https://your-domain.com
ADMIN_PASSWORD=change-me-to-a-long-secret
VODAFONE_CASH_NUMBER=010xxxxxxxx
INSTAPAY_ADDRESS=yourname@instapay
SUPPORT_WHATSAPP=2010xxxxxxxx
PRICE_MONTHLY_EGP=99
PRICE_YEARLY_EGP=990
FREE_PRODUCT_LIMIT=10
TRIAL_DAYS=14
REFERRAL_REWARD_DAYS=30
# حطها 1 لو السيرفر ورا proxy (Render / Railway / Nginx / Cloudflare)
TRUST_PROXY=1
NODE_ENV=production
DATA_DIR=./data
PORT=3000
